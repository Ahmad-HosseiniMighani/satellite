{
  "manifest_version": 3,
  "name": "career-ops-lite",
  "version": "0.1.0",
  "description": "Score job postings while you browse — light/normal/ultra tiers, scored against your own CV and deal-breakers, no career-ops checkout required.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://boards-api.greenhouse.io/*",
    "https://api.lever.co/*",
    "https://api.eu.lever.co/*",
    "https://api.ashbyhq.com/*",
    "https://*.myworkdayjobs.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "career-ops-lite"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
